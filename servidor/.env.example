# Configuración del servidor (Docker). Copia este archivo como .env y cambia las contraseñas.

# Puerto del panel/API en tu PC (la app Android usa IP-DE-TU-PC:API_PORT)
API_PORT=3000

# Usuario del panel de administración (se sincroniza en cada arranque)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# Base de datos PostgreSQL (contenedor "db")
# ⚠️ No cambies estos tres valores después de instalar.
POSTGRES_DB=moscasstream
POSTGRES_USER=moscas
POSTGRES_PASSWORD=cambia-esta-clave-db

# Firma de las sesiones del panel (cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# Autocompletado desde TMDb (opcional). Token de lectura de la API:
# https://www.themoviedb.org/settings/api  -> "API Read Access Token" (empieza por eyJ...)
TMDB_TOKEN=
TMDB_LANGUAGE=es-ES

# Puerto de PostgreSQL publicado SOLO en este PC (127.0.0.1), para pgAdmin/DBeaver
DB_PORT=5434
